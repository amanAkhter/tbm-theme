  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "comment.line.double-slash"
      ],
      "settings": {
        "foreground": "#637083",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "name": "String Interpolation & Templates",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#00d2b4"
      }
    },
    {
      "name": "Numbers & Constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Constants Other",
      "scope": [
        "constant",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "Storage & Modifiers",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "variable.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "Types, Classes, Interfaces, Enums",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#4ec9b0"
      }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.language",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#e4e8ee"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.comparison",
        "keyword.operator.assignment",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#8b9cb3"
      }
    },
    {
      "name": "Brackets & Delimiters",
      "scope": [
        "punctuation.definition.parameters",
        "punctuation.definition.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8b9cb3"
      }
    },
    {
      "name": "Decorators & Annotations",
      "scope": [
        "meta.decorator entity.name.function",
        "meta.decorator",
        "punctuation.definition.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#00d2b4"
      }
    },
    {
      "name": "HTML/XML/JSX Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "name": "Tag Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7dd3fc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "YAML Keys",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "CSS Selectors & Classes",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.media.css",
        "variable.css"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "CSS Values & Units",
      "scope": [
        "support.constant.property-value.css",
        "keyword.other.unit.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Shell Variables & Builtins",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#7dd3fc"
      }
    },
    {
      "name": "Rust Lifetimes & Macros",
      "scope": [
        "entity.name.type.lifetime.rust",
        "support.macro.rust",
        "entity.name.function.macro.rust"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Go Struct Tags & Package",
      "scope": [
        "entity.name.package.go",
        "meta.struct.tag.go"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "name": "Regular Expressions & Escapes",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f4a261"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#61afef",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e5c07b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c678dd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Inline Code & Blocks",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block",
        "markup.raw.block.fenced.markdown"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "name": "Markdown Quotes",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#637083",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#00d2b4"
      }
    },
    {
      "name": "Invalid & Deprecated",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f87171"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#4ec9b0",
    "class.defaultLibrary": "#4ec9b0",
    "comment": "#637083",
    "enum": "#4ec9b0",
    "enumMember": "#e5c07b",
    "function": "#61afef",
    "function.defaultLibrary": "#61afef",
    "interface": "#4ec9b0",
    "keyword": "#c678dd",
    "method": "#61afef",
    "number": "#e5c07b",
    "operator": "#8b9cb3",
    "parameter": "#e4e8ee",
    "property": "#7dd3fc",
    "property.readonly": "#e5c07b",
    "regexp": "#f4a261",
    "string": "#a3be8c",
    "struct": "#4ec9b0",
    "type": "#4ec9b0",
    "type.defaultLibrary": "#4ec9b0",
    "typeParameter": "#4ec9b0",
    "variable": "#e4e8ee",
    "variable.defaultLibrary": "#61afef",
    "variable.readonly": "#e5c07b"
  }
}
